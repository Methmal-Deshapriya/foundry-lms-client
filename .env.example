# Foundry LMS website (Next.js). Copy to .env.local for development and set
# the same names on the hosting platform for production. Real values never go
# in this file. Production startup checks live in next.config.ts.

# The API's public address, including /api/v1. Must be an absolute https://
# URL in production. In development it can also be a relative "/api/v1",
# which is then proxied to API_INTERNAL_BASE_URL.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000/api/v1"

# Development only: where the relative /api/v1 proxy and server-side fetches
# reach the API, when the browser can't use NEXT_PUBLIC_API_BASE_URL directly
# (e.g. through a tunnel). Leave unset in production.
# API_INTERNAL_BASE_URL="http://localhost:5000/api/v1"

# Required in production. The API calls /api/internal/catalog/revalidate with
# this secret when catalog content changes. Same value as the API's
# CATALOG_REVALIDATION_SECRET; 32+ random characters.
CATALOG_REVALIDATION_SECRET="generate-a-long-random-secret"

# Comma-separated https:// origins images may load from (Content-Security-
# Policy img-src). Include the R2 public bucket's address (the API's
# R2_PUBLIC_BASE_URL), or course thumbnails and avatars won't show.
NEXT_PUBLIC_IMAGE_ORIGINS="https://assets.example.com"

# Cloudflare account id (not a secret). Lets the browser upload straight to
# R2 (Content-Security-Policy connect-src). Same as the API's R2_ACCOUNT_ID.
NEXT_PUBLIC_R2_ACCOUNT_ID=""
